{
  "name": "apple-health-to-sqlite",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // No devcontainer Features on purpose. They are pulled from ghcr.io, which
  // fails on any machine with a stale ghcr.io entry in its Docker credential
  // store, and this project needs nothing they provide: the importer is
  // standard library only, and Python's built-in sqlite3 module does not
  // depend on the sqlite3 command line tool. If you want that tool anyway:
  //   sudo apt-get install -y sqlite3
  // (add -o Dir::Etc::sourceparts=/dev/null to apt-get update; a third-party
  // repository in the base image has an unverifiable signature.)

  "postCreateCommand": "pip install --user -e '.[dev]'",
  "forwardPorts": [8001],
  "portsAttributes": {
    "8001": {
      "label": "Datasette",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.testing.unittestEnabled": true,
        "python.testing.unittestArgs": ["-s", "tests", "-t", "."],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        }
      }
    }
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
  }
}
